# 이 파일을 복사해서 .env로 저장하고 값을 채우세요 (.env는 git에 올라가지 않음)
#   cp .env.example .env
#
# 앱(IntelliJ·Gradle 실행)과 docker compose가 모두 이 .env를 읽습니다.

# JWT 서명 키 (32바이트 이상). 만들기: openssl rand -base64 48
JWT_SECRET=

# 아래는 바꿀 때만 주석을 풀어서 사용 (기본값은 application.yaml, docker-compose.yml과 같음)
# DB_USERNAME=examguard
# DB_PASSWORD=examguard
# DB_PORT=5432
# APP_PORT=8080
